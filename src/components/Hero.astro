---
import { boda } from '../data/boda.js';
const { novios, ceremonia } = boda;
---

<header class="hero">
  <p class="intro">Nos complace invitarte a celebrar nuestra boda</p>

  <h1>
    <span class="nombre">{novios.ella}</span>
    <span class="amp">&amp;</span>
    <span class="nombre">{novios.el}</span>
  </h1>

  <p class="fecha">{ceremonia.fechaTexto} &nbsp;|&nbsp; {ceremonia.horaTexto}</p>

  <img
    src="/ilustracion.jpg"
    width="528"
    height="746"
    alt="Ilustración en acuarela de los novios frente a la Iglesia de la Encarnación"
  />
</header>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1.5rem 0;
  }

  .intro {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--acento);
    margin: 0 0 2rem;
  }

  h1 {
    font-family: var(--script);
    font-weight: 400;
    margin: 0 0 1.5rem;
    line-height: 1;
  }

  .nombre {
    display: block;
    font-size: clamp(3rem, 16vw, 4.5rem);
    color: var(--acento);
  }

  .amp {
    display: block;
    font-size: 1.6rem;
    color: var(--acento);
    margin: 0.2rem 0;
  }

  .fecha {
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    margin: 0 0 2rem;
  }

  /* La imagen es la invitación completa; recortamos por CSS a la ilustración. */
  img {
    display: block;
    width: 100%;
    height: clamp(18rem, 55vh, 30rem);
    object-fit: cover;
    object-position: 50% 100%;
  }
</style>
