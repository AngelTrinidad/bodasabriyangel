---
import { boda } from '../data/boda.js';
const { ceremonia } = boda;
---

<section class="ceremonia">
  <h2>La ceremonia</h2>
  <p class="lugar">{ceremonia.lugar}</p>
  <p class="ciudad">{ceremonia.ciudad}</p>
  <p class="cuando">{ceremonia.fechaTexto} · {ceremonia.horaTexto}</p>
  <a href={ceremonia.mapsUrl} target="_blank" rel="noopener">Ver ubicación</a>
</section>

<style>
  .ceremonia {
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  h2 {
    font-family: var(--script);
    font-weight: 400;
    font-size: 2rem;
    color: var(--acento);
    margin: 0 0 1.25rem;
  }

  .lugar {
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }

  .ciudad,
  .cuando {
    font-size: 0.95rem;
    color: #6b6659;
    margin: 0 0 0.25rem;
  }

  a {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.7rem 1.8rem;
    border: 1px solid var(--acento);
    border-radius: 999px;
    color: var(--acento);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  a:hover {
    background: var(--acento);
    color: var(--crema);
  }
</style>
