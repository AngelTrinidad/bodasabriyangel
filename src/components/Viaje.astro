---
import { boda } from '../data/boda.js';
const { viaje } = boda;
---

<section class="viaje">
  <h2>Después, {viaje.destino}</h2>
  <p class="fechas">{viaje.fechasTexto}</p>
  <p class="hotel">{viaje.hotel} · {viaje.zona}</p>
  <p class="nota">{viaje.nota}</p>
</section>

<style>
  .viaje {
    text-align: center;
    padding: 0 1.5rem 2.5rem;
  }

  h2 {
    font-family: var(--script);
    font-weight: 400;
    font-size: 2rem;
    color: var(--acento);
    margin: 0 0 1.25rem;
  }

  .fechas {
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
  }

  .hotel {
    font-size: 0.95rem;
    color: #6b6659;
    margin: 0 0 1.5rem;
  }

  .nota {
    font-size: 0.85rem;
    font-style: italic;
    color: #8a8578;
    margin: 0;
  }
</style>
