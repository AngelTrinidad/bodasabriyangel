---
import '../styles/global.css';
import { boda } from '../data/boda.js';
import Countdown from '../components/Countdown.astro';

const titulo = `${boda.novios.ella} & ${boda.novios.el} — ${boda.ceremonia.fechaTexto}`;
const descripcion = `Nos casamos el ${boda.ceremonia.fechaTexto} en ${boda.ceremonia.lugar}, ${boda.ceremonia.ciudad}.`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL('/ilustracion.jpg', Astro.site)} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main>
      <header>
        <h1>
          <span class="nombre">{boda.novios.ella}</span>
          <span class="amp">&amp;</span>
          <span class="nombre">{boda.novios.el}</span>
        </h1>
        <p class="fecha">{boda.ceremonia.fechaTexto} &nbsp;·&nbsp; {boda.ceremonia.horaTexto}</p>
      </header>

      <Countdown
        titulo="Faltan para el gran día"
        fechaISO={boda.ceremonia.fechaISO}
        mensajeLlegada="¡Hoy nos casamos!"
      />

      <hr />

      <Countdown
        titulo="Y para el viaje a Río"
        fechaISO={boda.viaje.fechaISO}
        mensajeLlegada="¡Nos vamos a Río!"
      />
    </main>
  </body>
</html>

<style>
  main {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 7vh, 4rem);
    padding: clamp(2rem, 8vh, 4rem) 1.25rem;
  }

  header {
    text-align: center;
  }

  h1 {
    font-family: var(--script);
    font-weight: 400;
    margin: 0 0 1rem;
    line-height: 1;
  }

  .nombre {
    display: block;
    font-size: clamp(2.8rem, 15vw, 4rem);
    color: var(--acento);
  }

  .amp {
    display: block;
    font-size: 1.4rem;
    color: var(--acento);
    margin: 0.2rem 0;
  }

  .fecha {
    font-size: clamp(0.9rem, 3.5vw, 1.05rem);
    letter-spacing: 0.12em;
    margin: 0;
  }
</style>
